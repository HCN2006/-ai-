9.7)\n    sec.top_margin = sec.bottom_margin = Cm(2.54)\n    sec.left_margin = sec.right_margin = Cm(3.17)\n    text_width = 21 - 3.17 * 2  # cm\n\n    paras = d.paragraphs\n    n = len(paras)\n    first_body_seen = False\n\n    for i, p in enumerate(paras):\n        text = p.text.strip()\n        style = p.style.name\n        has_math = bool(p._element.findall(qn(\"m:oMathPara\")))\n\n        # ---- 公式段落 ----\n        if has_math:\n            paras_math = p._element.findall(qn(\"m:oMathPara\"))\n            tag = \"\"\n            if len(paras_math) > 1:\n                tag = omath_text(paras_math[-1])\n                for extra in paras_math[1:]:\n                    p._element.remove(extra)\n            # 居中 + 右编号\n            p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n            p.paragraph_format.first_line_indent = None\n            if tag:\n                tag = tag.strip()\n                if not tag.startswith(\"(\"):\n                    tag = \"(\" + tag + \")\"\n                pf = p.paragraph_format\n                pf.tab_stops.add_tab_stop(Cm(text_width), WD_TAB_ALIGNMENT.RIGHT)\n                r = p.add_run(\"\\t\" + tag)\n                set_run(r, size=12, east=SONG)\n            continue\n\n        # ---- 图片段落 ----\n        if style == \"Captioned Figure\":\n            p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n            continue\n\n        # ---- 图题 ----\n        if style == \"Image Caption\":\n            fmt_para(p, size=10.5, align=WD_ALIGN_PARAGRAPH.CENTER, indent=None,\n                     spacing=1.0, after=6)\n            continue\n\n        # ---- 题名（第一段） ----\n        if i == 0 and \"面向海洋\" in text:\n            fmt_para(p, size=22, east=HEI, bold=True,\n                     align=WD_ALIGN_PARAGRAPH.CENTER, indent=None, after=6)\n            continue\n\n        # ---- 副题 ----\n        if text.startswith(\"——\") and i < 3:\n            fmt_para(p, size=14, align=WD_ALIGN_PARAGRAPH.CENTER, indent=None, after=18)\n            continue\n\n        # ---- 章标题 ----\n        if style == \"Heading 1\":\n            fmt_para(p, size=16, east=HEI, bold=True,\n                     align=WD_ALIGN_PARAGRAPH.CENTER, indent=None, before=24, after=18)\n            continue\n\n        # ---- 节标题 ----\n        if style == \"Heading 2\":\n            center = text in (\"摘要\", \"目次\")\n            fmt_para(p, size=14, east=HEI, bold=True,\n                     align=WD_ALIGN_PARAGRAPH.CENTER if center else WD_ALIGN_PARAGRAPH.LEFT,\n                     indent=None, before=18, after=12)\n            continue\n\n        # ---- 条标题 ----\n        if style == \"Heading 3\":\n            fmt_para(p, size=12, east=HEI, bold=True,\n                     align=WD_ALIGN_PARAGRAPH.LEFT, indent=None, before=12, after=6)\n            continue\n\n        # ---- 表题 ----\n        if re.match(r\"^表\\s*\\d+-\\d+\\s\", text) and not text.endswith((\"。\", \"，\", \"：\", \"；\")):\n            fmt_para(p, size=10.5, bold=True, align=WD_ALIGN_PARAGRAPH.CENTER,\n                     indent=None, spacing=1.0, before=6, after=3)\n            continue\n\n        # ---- 关键词 ----\n        if text.startswith(\"关键词\"):\n            p.paragraph_format.first_line_indent = None\n            p.paragraph_format.line_spacing = 1.5\n            for r in p.runs:\n                set_run(r, size=12, bold=(\"关键词\" in r.text))\n            continue\n\n        # ---- 代码块 ----\n        if style == \"Source Code\":\n            for r in p.runs:\n                set_run(r, size=9.5, east=MONO, ascii_f=MONO)\n            p.paragraph_format.line_spacing = 1.0\n            p.paragraph_format.first_line_indent = None\n            continue\n\n        # ---- 列表项 ----\n        if is_list_item(p):\n            fmt_para(p, size=12, indent=None, spacing=1.5)\n            continue\n\n        # ---- 参考文献条目（\"参考文献\"标题之后的普通段） ----\n        # 简化：所有含 \"[n]\" 开头或以数字点开头的参考文献行，用小五/五号\n        if re.match(r\"^\\[\\d+\\]\", text):\n            fmt_para(p, size=10.5, indent=None, spacing=1.3)\n            continue\n\n        # ---- 空段 / 分隔 ----\n        if not text:\n            continue\n\n        # ---- 正文段落 ----\n        fmt_para(p, size=12, indent=Pt(24), spacing=1.5)\n\n    # ---- 表格 ----\n    for tbl in d.tables:\n        for ri, row in enumerate(tbl.rows):\n            for cell in row.cells:\n                for cp in cell.paragraphs:\n                    cp.paragraph_format.first_line_indent = None\n                    cp.paragraph_format.line_spacing = 1.0\n                    if ri == 0:\n                        cp.alignment = WD_ALIGN_PARAGRAPH.CENTER\n                    for r in cp.runs:\n                        set_run(r, size=10.5, bold=(ri == 0))\n\n    d.save(DOCX)\n    print(f\"已重排并覆盖 {DOCX.name}\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
  "file_path": "src/style_docx.py"
}
