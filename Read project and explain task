base[\"coarse_err\"] * 0.1\n        def first_under(curve, t):\n            for pt in curve:\n                if pt[\"err\"] <= t:\n                    return pt\n            return None\n        base[\"target_err\"] = target\n        base[\"adaptive_at_target\"] = first_under(ad, target)\n        base[\"random_at_target\"] = first_under(rd, target)\n        results[name] = base\n        print(f\"\\n[{name}]  coarse_err={base['coarse_err']:.4f}  \"\n              f\"max_cv={base['cv_max']:.3f}  target={target:.5f}\")\n        for key in (\"adaptive_at_target\", \"random_at_target\"):\n            pt = base[key]\n            if pt:\n                print(f\"   {key:>18}: K={pt['K']:>5}  cells={pt['cells']:>7}  \"\n                      f\"err={pt['err']:.5f}  meta={8 * pt['K'] / 1024:>7.0f} KiB\")\n            else:\n                print(f\"   {key:>18}: 无法达到目标误差\")\n\n    DATA.mkdir(exist_ok=True)\n    PLOTS.mkdir(exist_ok=True)\n    with open(DATA / \"exp1_summary.json\", \"w\", encoding=\"utf-8\") as f:\n        json.dump(results, f, ensure_ascii=False, indent=2)\n\n    import csv\n    with open(DATA / \"exp1_pareto.csv\", \"w\", newline=\"\", encoding=\"utf-8\") as f:\n        w = csv.writer(f)\n        w.writerow([\"field\", \"scheme\", \"K\", \"cells\", \"err\"])\n        for field, res in results.items():\n            for scheme in (\"adaptive\", \"random\"):\n                for pt in res[scheme]:\n                    w.writerow([field, scheme, pt[\"K\"], pt[\"cells\"], pt[\"err\"]])\n\n    print(f\"\\n耗时 {time.time() - t0:.1f}s；已写 data/exp1_summary.json, data/exp1_pareto.csv\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
