) * 0 + (r['A'] * r['D']).mean() for r in rows]))\n        for T in Tgrid:\n            saves = []\n            for rep in range(REPEATS):\n                rng = np.random.default_rng(1000 * rep + int(T))\n                cache = {}\n                k = sweep(rows, noisy_score_T(T, rng, cache), [TARGET])[TARGET]\n                saves.append(7 * n / (n + 6 * k) if k else 1.0)\n            rng2 = random.Random(int(T))\n            kr = sweep(rows, lambda r: rng2.random(), [TARGET])[TARGET]\n            sav_r = 7 * n / (n + 6 * kr) if kr else 1.0\n            sm = float(np.mean(saves))\n            print(f\"   T={T:>5}  mean_N/cell={mean_N0*T:>8.2f}  noisy_saving={sm:5.2f}x (oracle {oracle_save:.2f}x, random {sav_r:.2f}x)\")\n            lines.append(f\"{fname},{T},{mean_N0*T:.2f},{oracle_save:.3f},{sm:.3f},{sav_r:.3f}\")\n\n    (ROOT / \"data\").mkdir(exist_ok=True)\n    (ROOT / \"data\" / \"exp3_boundary.csv\").write_text(\"\\n\".join(lines) + \"\\n\", encoding=\"utf-8\")\n    print(\"\\n已写 data/exp3_boundary.csv\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
